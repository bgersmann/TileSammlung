{
    "elements": [
        {
            "type": "Label",
            "bold": true,
            "caption": "Car Tile"
        },
        {
            "type": "Label",
            "caption": "Assign the variables of the car. Every variable is optional - missing values are simply not shown."
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "ValidationTextBox",
                    "name": "Name",
                    "caption": "Name (empty = instance name)"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "Icon",
                    "caption": "Icon"
                },
                {
                    "type": "SelectMedia",
                    "name": "ImageID",
                    "caption": "Vehicle image (optional)"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Variables",
            "expanded": true,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        { "type": "SelectVariable", "name": "LevelID", "caption": "Fuel / battery level (%)" },
                        { "type": "SelectVariable", "name": "RangeID", "caption": "Range" }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        { "type": "SelectVariable", "name": "MileageID", "caption": "Mileage" },
                        { "type": "SelectVariable", "name": "ParkID", "caption": "Parking state" }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        { "type": "SelectVariable", "name": "LockID", "caption": "Lock state" },
                        { "type": "ValidationTextBox", "name": "LockedText", "caption": "Text that counts as locked" }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        { "type": "SelectVariable", "name": "DoorsID", "caption": "Doors" },
                        { "type": "SelectVariable", "name": "WindowsID", "caption": "Windows" },
                        { "type": "SelectVariable", "name": "TrunkID", "caption": "Trunk" }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        { "type": "SelectVariable", "name": "AddressID", "caption": "Parking address" },
                        { "type": "SelectVariable", "name": "UpdatedID", "caption": "Last update" }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        { "type": "SelectVariable", "name": "ChargeModeID", "caption": "Charge mode" },
                        { "type": "SelectVariable", "name": "ChargeTargetID", "caption": "Target charging status" }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        { "type": "SelectVariable", "name": "PhaseModeID", "caption": "Phase mode" },
                        { "type": "SelectVariable", "name": "PhasesActiveID", "caption": "Active phases" }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        { "type": "SelectVariable", "name": "ChargeActiveID", "caption": "Target charging active (bool)" },
                        { "type": "SelectVariable", "name": "TargetSocID", "caption": "Target SOC (slider variable)" }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        { "type": "SelectVariable", "name": "TargetDateUseID", "caption": "Use target date (bool)" },
                        { "type": "SelectVariable", "name": "TargetDateID", "caption": "Target date" },
                        { "type": "SelectVariable", "name": "FullPowerID", "caption": "Full power from" }
                    ]
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Target charging: active/use date are toggled in the tile, the target SOC is adjusted with +/- (limits and step from its presentation). Variables need an action."
        },
        {
            "type": "Label",
            "caption": "Week graph: driven km per day are read from the archive of the mileage variable (must be logged)."
        },
        {
            "type": "Label",
            "caption": "Icon: any Font Awesome name, e.g. car-side, car, charging-station, truck-pickup."
        }
    ],
    "actions": [],
    "status": [
        { "code": 102, "icon": "active", "caption": "Instance is active" },
        { "code": 104, "icon": "inactive", "caption": "No variables configured yet" }
    ]
}
